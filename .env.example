# 离线模式无需任何模型密钥
APP_MODE=offline
DATA_SEED=20260809
HITL_AUDIENCE_THRESHOLD=50000
MAX_RETRIES=3

# 公开部署必须覆盖以下值；不要提交真实值到 Git。
PUBLIC_DEMO=false
REQUIRE_INVITE_CODE=false
DEMO_ACCESS_CODE=course-demo
DEMO_ACCESS_CODE_HASH=
APP_SIGNING_KEY=local-development-signing-key-change-me
SESSION_COOKIE_SECURE=false
PUBLIC_ORIGIN=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# 在线模式采用访客 BYOK。公开服务不应配置共享模型密钥。
OPENAI_API_KEY=
